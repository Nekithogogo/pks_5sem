# Скопируйте в .env и замените все значения на собственные либо запустите start.bat,
# который создаст случайные секреты автоматически.
POSTGRES_PASSWORD=change_this_database_password
JWT_SECRET_BASE64=replace_with_random_base64_key_at_least_32_bytes
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisTemporaryPassword1!
APP_PORT=8080
POSTGRES_PORT=55434
